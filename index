    const allFields = ['no', 'moo', 'road', 'sub', 'dist', 'prov'];

    allFields.forEach(k => {
        // หา element ของแต่ละช่อง: เช่น f_addr_no, m_addr_prov
        const input = el(p+'_addr_'+k);
        
        if(input) {
