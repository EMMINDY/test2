            if(callback) callback(); return;
        }
        let retry = 0;
        const interval = setInterval(() => {
            let isSet = false;
            targetEl.value = keyword;
            if (targetEl.value == keyword) isSet = true;
            if (!isSet && targetEl.options && targetEl.options.length > 0) {
                for (let i = 0; i < targetEl.options.length; i++) {
                    if (targetEl.options[i].text.trim() === keyword.trim()) {
                        targetEl.selectedIndex = i; isSet = true; break;
                    }
                }
            }
            if (isSet || retry > 50) {
                clearInterval(interval);
