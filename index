    div.style.display = isSame ? 'none' : 'block';

    // 2. จัดการเรื่อง "บังคับกรอก (Required)"
    // ช่องที่ "จำเป็น" ต้องกรอก (ถ้าเลือกกรอกเอง)
    const reqFields = ['no', 'sub', 'dist', 'prov']; 
