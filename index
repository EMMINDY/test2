            let planRetry = 0;
            const planInterval = setInterval(() => {
                // พยายามเลือกค่า
                if (planSelect.value !== targetPlan) {
                     planSelect.value = targetPlan;
                }
                
                // เช็คว่าเลือกติดไหม
                if (planSelect.value === targetPlan) { 
                    clearInterval(planInterval); 
                } 
                // ถ้าวนหา 2 วินาทีแล้วยังไม่เจอ (แปลว่าแผนเดิมอาจจะไม่มีในลิสต์)
                else if (planRetry > 20) {
