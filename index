    function readF(input, id) {
  // 1. เช็คว่ามีการเลือกไฟล์ไหม
  if (input.files && input.files[0]) {
    var file = input.files[0];
    var fileName = file.name;
    var fileSize = file.size;
    var extension = fileName.split('.').pop().toLowerCase(); // ดึงนามสกุลไฟล์มาเช็ค

    // -----------------------------------------------------------
    // ส่วนที่แก้ไข: เช็คขนาดไฟล์ไม่ให้เกิน 10 MB
    // -----------------------------------------------------------
    if (fileSize > 10 * 1024 * 1024) { // 10 MB
      Swal.fire({
        icon: 'warning',
        title: 'ขนาดไฟล์เกินกำหนด',
        text: 'ขนาดไฟล์ต้องไม่เกิน 10 MB',
        confirmButtonColor: '#d63384'
      });
      input.value = ''; // ล้างค่าไฟล์ที่เลือกออก
      return; // จบการทำงานทันที
    }

    // -----------------------------------------------------------
    // ส่วนที่เพิ่มใหม่: ตรวจสอบนามสกุลไฟล์ตามเงื่อนไข
    // -----------------------------------------------------------
    
    // กรณีที่ 1: ถ้าเป็นช่องรูปถ่าย (เช็คจาก id ที่ส่งเข้ามา)
    if (id === 'photo64') {
      if (!['png', 'jpeg', 'jpg'].includes(extension)) {
         Swal.fire({
            icon: 'error',
            title: 'นามสกุลไฟล์ไม่ถูกต้อง',
            html: 'รูปถ่ายต้องเป็นไฟล์สกุล <b>PNG หรือ JPEG</b> เท่านั้น',
            confirmButtonColor: '#d63384'
         });
         input.value = ''; 
         return;
      }
    } 
    // กรณีที่ 2: ถ้าเป็นเอกสารอื่นๆ (เช่น ปพ.1 หรือ ใบรับรอง)
    else {
      if (!['pdf', 'png', 'jpeg', 'jpg'].includes(extension)) {
         Swal.fire({
            icon: 'error',
            title: 'นามสกุลไฟล์ไม่ถูกต้อง',
            html: 'เอกสารต้องเป็นไฟล์สกุล <b>PDF, PNG หรือ JPEG</b> เท่านั้น',
            confirmButtonColor: '#d63384'
         });
         input.value = ''; 
         return;
      }
    }

    // -----------------------------------------------------------
    // ส่วนเดิม: อ่านไฟล์และแปลงเป็น Base64
    // -----------------------------------------------------------
    var reader = new FileReader();

    reader.onload = function(e) {
      // จัดการ Base64
      var pureBase64 = e.target.result.split(',')[1];
      var fileObj = {
        mimeType: file.type,
        data: pureBase64
      };
      
      // เอาค่าใส่ใน Hidden Input
      var targetInput = document.getElementById(id);
      if (targetInput) {
          targetInput.value = JSON.stringify(fileObj);
      }

      // แสดงตัวอย่างรูป (Preview) เฉพาะรูปถ่าย
      if (id === 'photo64') {
        const previewContainer = document.getElementById('newPhotoPreview');
        const previewImg = document.getElementById('imgPreview');
        const oldPhoto = document.getElementById('oldPhoto');

        if (previewImg) {
          previewImg.src = e.target.result; // ใส่รูปที่อ่านได้ลงไปใน tag img
          if (previewContainer) previewContainer.style.display = 'block'; // สั่งให้แสดง div
          if (oldPhoto) oldPhoto.style.display = 'none'; // ซ่อนรูปเดิม (ถ้ามี)
        }
      }
    };

    reader.readAsDataURL(file);
  }
}
   
